# Copy to `.env` and fill in. `.env` is git-ignored.
DATABASE_URL=postgres://typecast:typecast@localhost:5432/typecast
# At least 32 bytes. Generate one with: openssl rand -base64 48
TOKEN_SECRET=
# Optional
BIND_ADDR=0.0.0.0:3000
CORS_ORIGIN=http://localhost:5173
MAX_DB_CONNECTIONS=16
RUST_LOG=info,tower_http=info
