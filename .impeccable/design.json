        "value": "1100ms cubic-bezier(0.32, 0.72, 0, 1)",
        "purpose": "Raw and wpm lines draw once from the first second to the last; raw starts 120ms later."
      },
      {
        "name": "chart-marks",
        "value": "320ms ease-out, 900ms delay",
        "purpose": "Wpm dots and error crosses fade in as the trace ends."
      },
      {
        "name": "countdown-tone",
        "value": "240ms cubic-bezier(.32,.72,0,1)",
        "purpose": "Countdown colour from text to strong when typing starts."
      },
      {
        "name": "reduced-motion",
        "value": "transition: none; animation: none",
        "purpose": "Machine holds still; chips and countdown change instantly; Fig 2 and its chart appear finished."
