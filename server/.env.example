# Copy to `.env` and fill in. `.env` is git-ignored.
DATABASE_URL=postgres://platen:platen@localhost:5432/platen
# At least 32 bytes. Generate one with: openssl rand -base64 48
TOKEN_SECRET=
# Optional
BIND_ADDR=0.0.0.0:3000
# Built frontend to serve at /, from `dx bundle --platform web --release --out-dir dist` in web/
STATIC_DIR=../web/dist/public
MAX_DB_CONNECTIONS=16
RUST_LOG=info,tower_http=info
